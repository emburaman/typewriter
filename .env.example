# ---------------------------------------------------------------------------
# Typewriter — environment reference. Copy to .env.local (dev) or
# .env.production (prod) and fill in the values. Never commit real secrets.
# ---------------------------------------------------------------------------

# --- App ---
NODE_ENV=development
PORT=4000
# Public URL of the app (used to build the Google OAuth redirect URI).
APP_URL=http://localhost:4000

# --- App → MySQL connection ---
# Inside Docker Compose DB_HOST is overridden to "db".
DB_HOST=localhost
DB_PORT=3306
DB_NAME=typewriter
DB_USER=typewriter
DB_PASSWORD=change-me
DB_CONNECTION_LIMIT=10

# --- MySQL container bootstrap (must match the DB_* values above) ---
MYSQL_DATABASE=typewriter
MYSQL_USER=typewriter
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-root

# --- Accounts (Sign in with Google, invite-only) ---
# The first person to sign in becomes the admin and invites everyone else (Settings → Users).
# Set this so only YOUR Google account can become that first admin — important on any server
# reachable by others.
ADMIN_EMAIL=
# Test-only password-less sign-in for the automated browser tests. Refused when
# NODE_ENV=production. Leave false.
AUTH_DEV_LOGIN=false

# --- Google sign-in + Drive storage ---
# GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET are REQUIRED (they power "Sign in with Google").
# TOKEN_ENCRYPTION_KEY is additionally needed for users to connect their Google Drive.
# Create an OAuth client (type "Web application") in Google Cloud Console and add
#   <APP_URL>/api/google/callback  as an authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional override; defaults to ${APP_URL}/api/google/callback
GOOGLE_REDIRECT_URI=
# 32 random bytes, base64 — encrypts OAuth tokens at rest. Generate with:
#   openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# --- Google Fonts (optional) ---
# With a key, Settings offers the full Google Fonts catalog; without, a curated list.
GOOGLE_FONTS_API_KEY=
