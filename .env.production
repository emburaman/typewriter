# Production template (used by docker-compose.prod.yml).
# Replace every CHANGE_ME on the server you deploy to. Do not commit real values.
NODE_ENV=production
PORT=4000
APP_URL=https://typewriter.example.com

DB_HOST=db
DB_PORT=3306
DB_NAME=typewriter
DB_USER=typewriter
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DB_CONNECTION_LIMIT=10

MYSQL_DATABASE=typewriter
MYSQL_USER=typewriter
MYSQL_PASSWORD=CHANGE_ME_STRONG_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_STRONG_ROOT_PASSWORD

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
GOOGLE_FONTS_API_KEY=
