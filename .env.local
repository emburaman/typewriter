# Local development values (used by docker-compose.yml and `npm run dev`).
# These are throwaway dev credentials. Put real Google credentials here only on
# your machine — do not commit them.
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:4000

DB_HOST=localhost
DB_PORT=3306
DB_NAME=typewriter
DB_USER=typewriter
DB_PASSWORD=typewriter-dev
DB_CONNECTION_LIMIT=10

MYSQL_DATABASE=typewriter
MYSQL_USER=typewriter
MYSQL_PASSWORD=typewriter-dev
MYSQL_ROOT_PASSWORD=typewriter-root-dev

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
TOKEN_ENCRYPTION_KEY=
GOOGLE_FONTS_API_KEY=
